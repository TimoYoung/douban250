# 数据库（默认 SQLite）
# SQLite: sqlite:///./data/douban250.db
# MySQL: mysql+pymysql://user:password@localhost/douban250
# PostgreSQL: postgresql://user:password@localhost/douban250
DATABASE_URL=sqlite:///./data/douban250.db

# 豆瓣用户 ID（可选，用于"看过"列表对比）
DOUBAN_USER_ID=

# 豆瓣 Cookie（可选，提升反爬能力和数据完整性）
# 登录豆瓣后从浏览器开发者工具复制完整 Cookie 字符串
DOUBAN_COOKIE=

# 请求间隔（秒），建议 2-5，过快可能触发反爬
DOUBAN_REQUEST_DELAY=2.0

# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 日志文件目录（默认 ./data/logs）
# LOG_DIR=./data/logs
